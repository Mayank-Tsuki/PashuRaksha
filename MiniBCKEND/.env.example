PORT=5000
TOKEN_SECRET=replace-this-development-secret-before-deployment

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details.
# Example:
# MONGODB_URI=mongodb+srv://admin:mypassword@cluster0.abcde.mongodb.net/pashuraksha?retryWrites=true&w=majority
MONGODB_URI=
